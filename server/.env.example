# Comma-separated frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Port for local dev (hosting providers usually set PORT for you)
PORT=8000

# Set to 1 for Flask debug mode locally
FLASK_DEBUG=1

# Cache lifetimes in seconds
QUOTE_TTL_SECONDS=60
CHART_TTL_SECONDS=900
PROFILE_TTL_SECONDS=86400
